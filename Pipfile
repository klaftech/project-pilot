[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Source of truth for Python dependencies. Vercel installs from the committed Pipfile.lock:
# after editing this file run `pipenv lock` and commit both files.
[packages]
flask = "~=3.1.3"
werkzeug = "~=3.1.9"
flask-restful = "==0.3.10"
flask-sqlalchemy = "~=3.1.1"
flask-migrate = "~=4.1.0"
flask-bcrypt = "==1.0.1"
bcrypt = ">=4.3,<5"
sqlalchemy = ">=2.0.55,<2.1"
sqlalchemy-serializer = "~=1.6.3"
psycopg2-binary = "~=2.9.11"
python-dotenv = "~=1.2.4"
python-dateutil = ">=2.9,<3"

[dev-packages]
faker = ">=35,<41"
ipdb = ">=0.13.13"
pip-audit = ">=2.7"

[requires]
python_version = "3.12"
