# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string. For Neon, use the connection string from the Neon console
# (the -pooler host is fine for the app; server/export_db.py switches to the direct host itself).
#   local:  postgresql://user:password@localhost:5432/projectpilot
#   neon:   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URI=

# Who may sign up. Set a domain to allow everyone at that domain; list extra addresses as exceptions.
# With no domain set, only the listed exception addresses can sign up (closed by default).
#   SIGNUP_ALLOWED_DOMAIN=example.com
#   SIGNUP_ALLOWED_EMAIL_EXCEPTIONS=owner@example.org,contractor@example.net
SIGNUP_ALLOWED_DOMAIN=
SIGNUP_ALLOWED_EMAIL_EXCEPTIONS=

# Optional: throwaway database for the regression scenarios (name must end in _test; all tables are dropped).
# TEST_DATABASE_URI=postgresql://user@127.0.0.1:5432/pp_test

# Set automatically by Vercel; enables Secure session cookies. Leave unset locally.
# VERCEL=1
